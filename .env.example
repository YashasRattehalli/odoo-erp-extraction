# Copy to `.env` and fill in. The tool reads ODOO_* variables (or use CLI flags).
# Never commit a real .env — it holds credentials.

# --- Target instance ---
ODOO_BASE_URL=https://your-trial.odoo.com
ODOO_DB=your-trial                 # optional for single-DB SaaS trials
ODOO_USERNAME=you@example.com
ODOO_PASSWORD=your-password

# --- What to extract ---
ODOO_TARGET_CUSTOMER=Deco Addict   # alias 'Acme Corporation' is tried automatically on Odoo 16+

# --- Browser / output ---
ODOO_HEADLESS=true                 # set false (or pass --headed) to watch the run
ODOO_OUTPUT_PATH=output/invoice_extract.json
ODOO_USER_DATA_DIR=.pw-profile

# --- Privacy / logging ---
ODOO_LOG_LEVEL=INFO
ODOO_ENABLE_PRESIDIO=false         # deny-list + regex always run; this adds the NER backstop
ODOO_DEIDENTIFY=false              # set true to emit a HIPAA Safe-Harbor de-identified extract
# ODOO_DEID_SALT=change-me-per-deployment
